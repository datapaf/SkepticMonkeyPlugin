{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/node_modules/typescript/bin/tsc", "-p", "${workspaceFolder}"],
      "options": {
        "env": {
          "Path": "C:\\Program Files\\nodejs;${env:Path}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/typescript/bin/tsc",
        "-watch",
        "-p",
        "${workspaceFolder}"
      ],
      "options": {
        "env": {
          "Path": "C:\\Program Files\\nodejs;${env:Path}"
        }
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "group": "build"
    }
  ]
}
